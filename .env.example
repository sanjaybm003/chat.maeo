# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) or the legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) or the legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
# The public origin of this deployment, exact https:// address, no trailing slash.
# On Vercel you can leave it unset: the production domain is used automatically.
# NEXT_PUBLIC_* values are baked in at build time; redeploy after changing them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show "Continue with Google" once the provider is enabled in Supabase Auth
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# debug | info | warn | error (defaults: debug in dev, info in production)
LOG_LEVEL=

# ─── AI agents (optional) ────────────────────────────────────────────────────
# The platform's own provider keys. People using maeosan never add keys: they
# spend the AI credits on their account (10,000 each to start). Add a key for
# each provider you want to offer; only models with a key appear, and "Auto"
# routes between them. Agents also need SUPABASE_SERVICE_ROLE_KEY above.
# Server only; never prefix these with NEXT_PUBLIC.
# Anthropic (Claude):  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google (Gemini):     https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI (GPT):        https://platform.openai.com/api-keys
OPENAI_API_KEY=
# DeepSeek:            https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Claude through Amazon Bedrock, with an Amazon Bedrock API key (Bedrock console →
# API keys). Use a long-term key on a server; short-term keys expire within 12 hours.
# Claude models must be enabled under Model access in that AWS account first.
# Claude Code's layout works too: the Bedrock key in ANTHROPIC_API_KEY plus
# ANTHROPIC_BASE_URL=https://bedrock-mantle.<region>.api.aws/anthropic.
# When a real Anthropic key is also set, Claude runs through Anthropic unless CLAUDE_HOST=bedrock.
# The same key also runs open models on Bedrock (DeepSeek, Qwen, Mistral, gpt-oss), which need no
# AWS Marketplace access; agents switch to them automatically when the account can't use Claude.
BEDROCK_API_KEY=
# The AWS region to call Bedrock in. Kept separate because Vercel sets its own AWS_REGION.
BEDROCK_REGION=us-east-1
# anthropic | bedrock. Only needed when both Claude keys are set.
CLAUDE_HOST=
# Agents search the web with the Bedrock key above (Amazon Bedrock Web Search, or Nova
# web grounding), and read pages people share with no key at all. Optional: a Tavily key
# is tried first when set.  https://app.tavily.com
TAVILY_API_KEY=

# ─── GitHub (optional) ───────────────────────────────────────────────────────
# Lets workspace admins connect GitHub so agents can read code and open pull requests.
# Register one GitHub App for this deployment at https://github.com/settings/apps/new
#   Callback URL: https://<your-domain>/api/integrations/github/callback
#   Tick "Request user authorization (OAuth) during installation". Webhook: off.
#   Repository permissions: Contents (read & write), Pull requests (read & write), Metadata (read).
# Generate a client secret and a private key. Paste the whole .pem as the private key;
# on one line, write its line breaks as \n.
GITHUB_APP_ID=
# From the app's address: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# ─── Email (optional) ────────────────────────────────────────────────────────
# With a Resend key, invitations go out with maeosan's own template.
# Without one, Supabase Auth delivers them.
RESEND_API_KEY=
# The quotes are for this file only. In Vercel, enter: maeosan <team@yourdomain.com>
EMAIL_FROM="maeosan <team@yourdomain.com>"

# ─── Web push (optional) ─────────────────────────────────────────────────────
# Background notifications when maeosan isn't open. Generate keys with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@yourdomain.com
# Shared with the database so only Postgres can trigger dispatch. 32+ random
# characters, e.g. `openssl rand -hex 32`. Store the same value in
# private.app_config (see README → Web push).
PUSH_DISPATCH_SECRET=
